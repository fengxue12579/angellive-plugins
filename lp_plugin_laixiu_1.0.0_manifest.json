{
  "pluginId": "laixiu",
  "version": "1.0.0",
  "apiVersion": 1,
  "displayName": "来秀直播",
  "platformDescription": "来秀(imkktv.com) — 通过 Cookie 鉴权访问来秀直播平台",
  "liveTypes": ["laixiu"],
  "entry": "lp_plugin_laixiu_1.0.0_index.js",
  "auth": {
    "required": true,
    "credentialKinds": ["cookie"],
    "supportsStatusCheck": false,
    "supportsValidation": false
  },
  "loginFlow": {
    "kind": "webview",
    "loginURL": "https://www.imkktv.com",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    "cookieDomains": [
      "imkktv.com"
    ],
    "authSignalCookies": [
      "accessToken"
    ],
    "uidCookieNames": [
      "userId"
    ],
    "websiteHost": "www.imkktv.com"
  },
  "capabilities": {
    "categories": { "status": "available" },
    "rooms": { "status": "available" },
    "playback": { "status": "available" },
    "search": { "status": "available" },
    "roomDetail": { "status": "available" },
    "liveState": { "status": "available" },
    "shareResolve": { "status": "available" },
    "danmaku": { "status": "unavailable" }
  },
  "shareResolve": {
    "hosts": ["www.imkktv.com", "imkktv.com", "m.imkktv.com"]
  },
  "hostBehavior": {
    "playableLiveStates": ["1"],
    "externalRoomURLTemplate": "https://www.imkktv.com/{roomId}",
    "themeColor": "#FF6B9D"
  }
}